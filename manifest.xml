<?xml version="1.0"?>
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application entry="First10App"
                   id="f8977f95a1b74c0e9d3e2a6b5c4d1e0f"
                   launcherIcon="@Drawables.LauncherIcon"
                   name="@Strings.AppName"
                   type="watch-app"
                   minApiLevel="3.4.0">
        <!-- Forerunner 265 is the primary target. FR265S added for the smaller
             screen variant since it shares the same platform and sensors. -->
        <iq:products>
            <iq:product id="fr265"/>
            <iq:product id="fr265s"/>
        </iq:products>
        <!-- Sensor is required for high-frequency accelerometer/gyroscope data
             (registerSensorDataListener) and optical heart rate events. Steps
             come from ActivityMonitor, which needs no extra permission. -->
        <iq:permissions>
            <iq:uses-permission id="Sensor"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
    </iq:application>
</iq:manifest>
